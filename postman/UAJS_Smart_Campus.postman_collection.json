{
  "info": {
    "name": "UAJS Smart Campus — API",
    "description": "Colección del Entregable 2. Todas las peticiones pasan por el API Gateway ({{baseUrl}}).\n\nUso: importar esta colección y el entorno `Local`, completar `adminPassword` en el entorno (valor actual) y ejecutar en orden con el Collection Runner. La carpeta 99 se ejecuta aparte (ver su descripción).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "00 · Gateway",
      "description": "Salud del sistema, rutas publicadas, rutas inexistentes y CORS (SD2-08).",
      "item": [
        {
          "name": "Health: gateway y 6 servicios",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Gateway ok\", () => pm.expect(body.gateway).to.eql(\"ok\"));",
                  "pm.test(\"Los 6 servicios en ok\", () => {",
                  "  pm.expect(Object.keys(body.services)).to.have.lengthOf(6);",
                  "  Object.values(body.services).forEach(state => pm.expect(state).to.eql(\"ok\"));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Información del gateway",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": []
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Lista las rutas publicadas\", () => pm.expect(pm.response.json().endpoints).to.be.an(\"array\").that.includes(\"/api/solicitudes\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Ruta inexistente → 404 JSON",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/no-existe",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "no-existe"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"Devuelve JSON con error\", () => pm.expect(pm.response.json()).to.have.property(\"error\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "CORS: origen permitido",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Origin",
                "value": "http://localhost:5173"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Permite el frontend\", () => pm.expect(pm.response.headers.get(\"Access-Control-Allow-Origin\")).to.eql(\"http://localhost:5173\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "CORS: origen no permitido",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Origin",
                "value": "http://sitio-cualquiera.com"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"No autoriza otros orígenes\", () => pm.expect(pm.response.headers.get(\"Access-Control-Allow-Origin\")).to.be.undefined);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 · Auth",
      "description": "Inicio de sesión, renovación de token y registro de usuarios. Ejecutar primero: guarda los tokens que usan las demás carpetas.",
      "item": [
        {
          "name": "Login administrador (válido)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Entrega accessToken y refreshToken\", () => { pm.expect(body.accessToken).to.be.a(\"string\"); pm.expect(body.refreshToken).to.be.a(\"string\"); });",
                  "pm.test(\"Rol administrador\", () => pm.expect(body.usuario.rol).to.eql(\"administrador\"));",
                  "pm.test(\"No expone la contraseña\", () => pm.expect(body.usuario).to.not.have.property(\"password_hash\"));",
                  "pm.environment.set(\"token\", body.accessToken);",
                  "pm.environment.set(\"refreshToken\", body.refreshToken);",
                  "pm.environment.set(\"adminId\", body.usuario.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login con contraseña incorrecta → 401",

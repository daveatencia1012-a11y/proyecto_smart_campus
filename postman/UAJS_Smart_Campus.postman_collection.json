              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test(\"Crea el usuario con rol estudiante\", () => pm.expect(body.usuario.rol).to.eql(\"estudiante\"));",
                  "pm.environment.set(\"studentId\", body.usuario.id);"
                ]
              }
            }

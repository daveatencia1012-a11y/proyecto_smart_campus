# ============================================================
#  .env.example - Variables de entorno del backend (Docker Compose)
# ============================================================
#  Copia este archivo como backend/.env y completa los valores:
#    cp .env.example .env
#
#  docker-compose.yml lee backend/.env automaticamente. Si falta
#  una variable obligatoria, ningun comando de compose se ejecuta.
#
#  Reglas:
#    - El archivo .env real NUNCA se sube al repositorio.
#    - No dejes espacios alrededor del signo "=".
#    - Genera cada clave por separado con: openssl rand -hex 32
#      (en Windows, desde Git Bash). No reutilices el mismo valor.
#    - Si cambias una clave de base de datos con un volumen ya
#      creado, el volumen conserva la anterior: recrealo con
#      "docker compose down -v" (borra los datos).
# ============================================================


# ------------------------------------------------------------
#  AUTENTICACION (obligatorias)
# ------------------------------------------------------------

# Clave aleatoria compartida por los seis microservicios para firmar
# y verificar los tokens de acceso.
# Generar localmente con: openssl rand -hex 32
# Minimo 32 bytes, sin espacios al inicio/final ni valores de ejemplo.
# Al rotarla se invalidan los tokens firmados con la clave anterior.
JWT_SECRET=

# Clave de los tokens de renovacion: aleatoria y DIFERENTE de JWT_SECRET.
# Generar otra clave con: openssl rand -hex 32
JWT_REFRESH_SECRET=

# Token interno para que requests, reservations y events creen
# notificaciones en notifications-service.
# Generar otra clave con: openssl rand -hex 32
INTERNAL_API_TOKEN=


# ------------------------------------------------------------
#  BASE DE DATOS MYSQL (obligatorias)
# ------------------------------------------------------------

# Contrasena del usuario root de MySQL. Solo la usa el contenedor
# de MySQL; no se entrega a los microservicios.
# Con un volumen ya existente debe ser la contrasena root actual.
MYSQL_ROOT_PASSWORD=

# Una contrasena DIFERENTE por microservicio (cuentas campus_*),
# cada una con: openssl rand -hex 32 (64 caracteres hexadecimales).
# El aprovisionamiento rechaza contrasenas repetidas o iguales a root.
USERS_DB_PASSWORD=
REQUESTS_DB_PASSWORD=
RESERVATIONS_DB_PASSWORD=
RESOURCES_DB_PASSWORD=
EVENTS_DB_PASSWORD=
NOTIFICATIONS_DB_PASSWORD=


# ------------------------------------------------------------
#  VIGENCIA DE LOS TOKENS (opcionales)
# ------------------------------------------------------------

# Vigencia del token de acceso (formato de jsonwebtoken). Por defecto: 15m.
JWT_EXPIRES_IN=15m

# Vigencia del token de renovacion. Por defecto: 7d.
JWT_REFRESH_EXPIRES_IN=7d


# ------------------------------------------------------------
#  RESERVAS (opcionales)
# ------------------------------------------------------------

# Horario permitido para reservar recursos (HH:MM, 24 horas).
# Por defecto: 08:00 a 22:00.
BUSINESS_HOURS_START=08:00
BUSINESS_HOURS_END=22:00

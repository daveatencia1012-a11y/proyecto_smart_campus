# ============================================================
#  .env.example - PLANTILLA DE EJEMPLO
# ============================================================
#  Este archivo solo muestra COMO se documentan variables de
#  entorno. NO contiene las claves ni los valores reales del
#  proyecto: todos los nombres y valores son ficticios.
#
#  Uso:
#    cp .env.example .env
#    # edita .env con tus valores reales
#
#  Reglas:
#    - El archivo .env real NUNCA se sube al repositorio.
#    - Usa comillas solo cuando el valor tenga espacios.
#    - No dejes espacios alrededor del signo "=".
#    - Un "#" al inicio de la linea es un comentario.
# ============================================================


# ------------------------------------------------------------
#  SERVIDOR
# ------------------------------------------------------------

# Puerto TCP donde escucha la aplicacion.
# Valores tipicos: 3000, 4000, 8080. Rango valido: 1024-65535.
APP_PORT=3000

# Entorno de ejecucion: development | staging | production.
# En "production" no se deben exponer trazas de error al cliente.
APP_ENV=development

# Host y puerto a los que se enlaza el servidor.
# 127.0.0.1 acepta solo conexiones locales; 0.0.0.0 acepta externas.
APP_HOST=127.0.0.1


# ------------------------------------------------------------
#  BASE DE DATOS
# ------------------------------------------------------------

# URL completa de conexion.
# Formato: motor://usuario:contrasena@host:puerto/nombre_bd
# Codifica los caracteres especiales de la contrasena.
DATABASE_URL=postgresql://demo_user:demo_pass@127.0.0.1:5432/demo_db

# Numero maximo de conexiones simultaneas del pool.
# Aumentalo solo si la base de datos lo soporta.
DATABASE_POOL_SIZE=10

# Tiempo maximo de espera para obtener una conexion, en milisegundos.
DATABASE_TIMEOUT_MS=5000

# Muestra las consultas SQL en la consola: true | false.
# Debe ser "false" en produccion.
DATABASE_LOGGING=false


# ------------------------------------------------------------
#  AUTENTICACION Y SECRETOS
# ------------------------------------------------------------

# Obligatoria: clave aleatoria compartida por los seis microservicios.
# Generar localmente con: openssl rand -hex 32
# Minimo 32 bytes, sin espacios al inicio/final ni valores de ejemplo.
# Configurala manualmente en .env; no la subas al repositorio ni la compartas.
# Al rotarla se invalidan los tokens firmados con la clave anterior.
JWT_SECRET=

# Obligatoria, aleatoria y DIFERENTE de JWT_SECRET.
# Generar otra clave con: openssl rand -hex 32
JWT_REFRESH_SECRET=

# Compartida solo por requests/reservations/events y notifications.
# Generar otra clave con: openssl rand -hex 32
INTERNAL_API_TOKEN=

# Docker: conservar la contraseña root actual si el volumen ya existe.
# No se distribuye a los microservicios.
MYSQL_ROOT_PASSWORD=

# Una contraseña DIFERENTE por servicio, generada cada una con:
# openssl rand -hex 32 (exactamente 64 caracteres hexadecimales).
# El aprovisionamiento rechaza contraseñas repetidas o iguales a root.
USERS_DB_PASSWORD=
REQUESTS_DB_PASSWORD=
RESERVATIONS_DB_PASSWORD=
RESOURCES_DB_PASSWORD=
EVENTS_DB_PASSWORD=
NOTIFICATIONS_DB_PASSWORD=

# Vigencia del token de acceso, en minutos.
AUTH_TOKEN_TTL_MINUTES=60

# Vigencia del token de refresco, en dias.
AUTH_REFRESH_TTL_DAYS=7

# Algoritmo de firma del token. Ejemplo: HS256.
AUTH_ALGORITHM=HS256

# Vigencia del access token usada por los servicios (formato de jsonwebtoken).
JWT_EXPIRES_IN=15m

# Vigencia del refresh token usada por los servicios (formato de jsonwebtoken).
JWT_REFRESH_EXPIRES_IN=7d


# ------------------------------------------------------------
#  SERVICIOS EXTERNOS
# ------------------------------------------------------------

# Clave de una API de terceros. Se obtiene en el panel del proveedor.
THIRD_PARTY_API_KEY=tu_api_key_de_ejemplo

# URL base del servicio externo. No incluyas la barra final.
THIRD_PARTY_BASE_URL=https://api.ejemplo.com/v1

# Tiempo maximo de espera por respuesta, en milisegundos.
THIRD_PARTY_TIMEOUT_MS=5000

# Reintentos ante fallos de red. 0 desactiva los reintentos.
THIRD_PARTY_RETRIES=3

# Servicio de cache. Formato: protocolo://host:puerto
CACHE_URL=redis://127.0.0.1:6379


# ------------------------------------------------------------
#  CORREO (SMTP)
# ------------------------------------------------------------

# Servidor SMTP de ejemplo.
# En Gmail/Outlook usa una "contrasena de aplicacion", no tu clave real.
SMTP_HOST=smtp.ejemplo.com
SMTP_PORT=587
SMTP_USER=correo@ejemplo.com
SMTP_PASS=contrasena_de_ejemplo

# Cifrado de la conexion: true | false.
# true suele corresponder al puerto 465; false al 587 con STARTTLS.
SMTP_SECURE=false


# ------------------------------------------------------------
#  COMPORTAMIENTO Y DIAGNOSTICO
# ------------------------------------------------------------

# Nivel de detalle de los logs: error | warn | info | debug.
LOG_LEVEL=info

# Activa o desactiva una funcionalidad: true | false.
FEATURE_DEMO_MODE=true

# Zona horaria en formato IANA. Ejemplo: America/Bogota.
APP_TIMEZONE=UTC
